<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDEEF4"
    android:padding="24dp">

    <LinearLayout
        android:id="@+id/headerText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Do you have any reproductive problems?"
            android:textAlignment="center"
            android:textColor="#000000"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="This assists us with understanding your personal designs better"
            android:textColor="#424242"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/headerText"
        android:layout_marginTop="32dp"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/option1"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical|start"
            android:paddingStart="24dp"
            android:text="Yes"
            android:textAllCaps="false"
            android:textColor="#000000"
            android:textSize="18sp"
            app:backgroundTint="#FFFFFF"
            app:cornerRadius="8dp"
            app:strokeColor="#BDBDBD" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/option2"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical|start"
            android:paddingStart="24dp"
            android:text="No"
            android:textAllCaps="false"
            android:textColor="#000000"
            android:textSize="18sp"
            app:backgroundTint="#FFFFFF"
            app:cornerRadius="8dp"
            app:strokeColor="#BDBDBD" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/option3"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical|start"
            android:paddingStart="24dp"
            android:text="No, yet I used to"
            android:textAllCaps="false"
            android:textColor="#000000"
            android:textSize="18sp"
            app:backgroundTint="#FFFFFF"
            app:cornerRadius="8dp"
            app:strokeColor="#BDBDBD" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/option4"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical|start"
            android:paddingStart="24dp"
            android:text="Not sure"
            android:textAllCaps="false"
            android:textColor="#000000"
            android:textSize="18sp"
            app:backgroundTint="#FFFFFF"
            app:cornerRadius="8dp"
            app:strokeColor="#BDBDBD" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/nextButton"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#C2185B"
        android:text="NEXT"
        android:textSize="18sp"
        app:cornerRadius="12dp" />

</RelativeLayout>
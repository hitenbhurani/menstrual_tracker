<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDEEF4">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomSection"
        android:fillViewport="true"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Any uneasiness because of any of the accompanying?"
                    android:textAlignment="center"
                    android:textColor="#000000"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="This assists us with understanding your personal designs better"
                    android:textColor="#424242"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/symp1"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="65dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical|start"
                    android:paddingStart="24dp"
                    android:text="Painful Feminine spasms"
                    android:textAllCaps="false"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    app:backgroundTint="#FFFFFF"
                    app:cornerRadius="8dp"
                    app:strokeColor="#BDBDBD" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/symp2"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="65dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical|start"
                    android:paddingStart="24dp"
                    android:text="PMS symptoms"
                    android:textAllCaps="false"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    app:backgroundTint="#FFFFFF"
                    app:cornerRadius="8dp"
                    app:strokeColor="#BDBDBD" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/symp3"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="65dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical|start"
                    android:paddingStart="24dp"
                    android:text="Uncommon release"
                    android:textAllCaps="false"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    app:backgroundTint="#FFFFFF"
                    app:cornerRadius="8dp"
                    app:strokeColor="#BDBDBD" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/symp4"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="65dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical|start"
                    android:paddingStart="24dp"
                    android:text="Weighty feminine stream"
                    android:textAllCaps="false"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    app:backgroundTint="#FFFFFF"
                    app:cornerRadius="8dp"
                    app:strokeColor="#BDBDBD" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/symp5"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="65dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical|start"
                    android:paddingStart="24dp"
                    android:text="State of mind swings"
                    android:textAllCaps="false"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    app:backgroundTint="#FFFFFF"
                    app:cornerRadius="8dp"
                    app:strokeColor="#BDBDBD" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/symp6"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="65dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical|start"
                    android:paddingStart="24dp"
                    android:text="No, nothing bothers me"
                    android:textAllCaps="false"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    app:backgroundTint="#FFFFFF"
                    app:cornerRadius="8dp"
                    app:strokeColor="#BDBDBD" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/symp7"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="65dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical|start"
                    android:paddingStart="24dp"
                    android:text="Other"
                    android:textAllCaps="false"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    app:backgroundTint="#FFFFFF"
                    app:cornerRadius="8dp"
                    app:strokeColor="#BDBDBD" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/otherInputLayout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:visibility="gone"
                    app:boxCornerRadiusBottomEnd="8dp"
                    app:boxCornerRadiusBottomStart="8dp"
                    app:boxCornerRadiusTopEnd="8dp"
                    app:boxCornerRadiusTopStart="8dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/otherInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Please specify..."
                        android:inputType="textMultiLine" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#FDEEF4"
        android:padding="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nextButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:backgroundTint="#C2185B"
            android:text="NEXT"
            android:textSize="18sp"
            app:cornerRadius="12dp" />
    </LinearLayout>

</RelativeLayout>
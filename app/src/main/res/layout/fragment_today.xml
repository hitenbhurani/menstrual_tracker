<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDEEF4"
    android:padding="24dp">

    <TextView
        android:id="@+id/todayDateText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"
        android:text="Today, Loading..."
        android:textColor="#000000"
        android:textSize="20sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/weeklyCalendarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/todayDateText"
        android:layout_marginTop="24dp"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:weightSum="7">

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="S" android:textColor="#BDBDBD" android:textSize="14sp" />
            <TextView android:id="@+id/date1" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginTop="8dp" android:gravity="center" android:text="-" android:textColor="#000000" android:textSize="16sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="M" android:textColor="#BDBDBD" android:textSize="14sp" />
            <TextView android:id="@+id/date2" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginTop="8dp" android:gravity="center" android:text="-" android:textColor="#000000" android:textSize="16sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="T" android:textColor="#BDBDBD" android:textSize="14sp" />
            <TextView android:id="@+id/date3" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginTop="8dp" android:gravity="center" android:text="-" android:textColor="#000000" android:textSize="16sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="W" android:textColor="#BDBDBD" android:textSize="14sp" />
            <TextView android:id="@+id/date4" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginTop="8dp" android:gravity="center" android:text="-" android:textColor="#000000" android:textSize="16sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="T" android:textColor="#BDBDBD" android:textSize="14sp" />
            <TextView android:id="@+id/date5" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginTop="8dp" android:gravity="center" android:text="-" android:textColor="#000000" android:textSize="16sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="F" android:textColor="#BDBDBD" android:textSize="14sp" />
            <TextView android:id="@+id/date6" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginTop="8dp" android:gravity="center" android:text="-" android:textColor="#000000" android:textSize="16sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="S" android:textColor="#BDBDBD" android:textSize="14sp" />
            <TextView android:id="@+id/date7" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginTop="8dp" android:gravity="center" android:text="-" android:textColor="#000000" android:textSize="16sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <RelativeLayout
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_below="@id/weeklyCalendarLayout"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_hexagon">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Next period:"
                android:textColor="#D81B60"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/predictedPeriodText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Calculating..."
                android:textColor="#C2185B"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chanceText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Calculating\nchances..."
                android:textColor="#424242"
                android:textSize="14sp" />
        </LinearLayout>
    </RelativeLayout>

</RelativeLayout>
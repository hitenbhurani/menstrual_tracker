<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- By leaving this file almost empty, the app will automatically use
         the dark mode colors defined in /values-night/colors.xml -->
    <style name="Theme.FemCare" parent="Base.Theme.FemCare" />

    <style name="TrackerChip">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">12dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:background">@drawable/bg_symptom_unselected</item>
    </style>
</resources>
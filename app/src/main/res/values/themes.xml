<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.FemCare" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Main theme colors. -->
        <item name="colorPrimary">#C2185B</item>
        <item name="colorPrimaryVariant">#880E4F</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">#E91E63</item>
        <item name="colorSecondaryVariant">#F06292</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">#C2185B</item>
        <!-- Background colors -->
        <item name="android:windowBackground">#FDEEF4</item>
    </style>

    <style name="Theme.FemCare" parent="Base.Theme.FemCare" />

    <style name="TrackerChip">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">12dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#1A1A1A</item>
        <item name="android:background">@drawable/bg_symptom_unselected</item>
    </style>
</resources>